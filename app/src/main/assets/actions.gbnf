root ::= reply | call
reply ::= "{" ws "\"reply\"" ws ":" ws string "}" ws
call ::= "{" ws "\"tool\"" ws ":" ws tool-name "," ws "\"args\"" ws ":" ws object "}" ws
tool-name ::= ("\"search_notes\"" | "\"read_note\"" | "\"open_note\"" | "\"list_planner\"" | "\"read_task\"" | "\"open_task\"" | "\"read_event\"" | "\"open_event\"" | "\"open_calendar\"" | "\"create_note\"" | "\"update_note\"" | "\"delete_note\"" | "\"create_task\"" | "\"update_task\"" | "\"delete_task\"" | "\"create_event\"" | "\"update_event\"" | "\"delete_event\"" | "\"change_appearance\"" | "\"list_models\"" | "\"change_parameters\"") ws
value  ::= object | array | string | number | ("true" | "false" | "null") ws

object ::=
  "{" ws (
            string ":" ws value
    ("," ws string ":" ws value)*
  )? "}" ws

array  ::=
  "[" ws (
            value
    ("," ws value)*
  )? "]" ws

string ::=
  "\"" (
    [^"\\\x7F\x00-\x1F] |
    "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4}) # escapes
  )* "\"" ws

number ::= ("-"? ([0-9] | [1-9] [0-9]{0,15})) ("." [0-9]+)? ([eE] [-+]? [0-9] [1-9]{0,15})? ws

# Optional space: by convention, applied in this grammar after literal chars when allowed
ws ::= | " " | "\n" [ \t]{0,20}
